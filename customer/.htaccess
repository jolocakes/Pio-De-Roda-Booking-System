# T-61: the pages in this directory contain no inline <script> blocks and no
# inline event handlers (onclick/onsubmit/…), so they can run a stricter CSP
# than the shared root policy. The only difference is script-src: 'unsafe-inline'
# is removed here while the admin pages (outside this directory) still need it
# until their inline scripts are extracted too.
<IfModule mod_headers.c>
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com https://www.google.com https://maps.google.com; media-src 'self'; worker-src 'self' blob:"
</IfModule>
