# Local secrets / environment-specific config
.env
.env.*
!.env.example
config/xendit.php

# Mail outbox contains customer PII and plaintext booking PINs.
# Keep the directory deny rule, but never track its contents.
api/mail/outbox/*
!api/mail/outbox/.htaccess

# Root-level database dumps (schema/data exports). Migrations under
# database/ stay tracked; anything dumped into the web root is ignored.
/*.sql

# OS/editor
.DS_Store
Thumbs.db
*.log
