# Database migration and seed scripts must never be reachable over HTTP.
# The PHP scripts also carry CLI guards, but denying the whole directory is
# defense in depth for any file added later.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
