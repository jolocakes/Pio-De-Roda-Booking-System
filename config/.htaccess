# The config directory holds secrets (.env loading, Xendit credentials, mail
# settings) and server-side includes. Nothing here is meant to be fetched
# directly over HTTP; PHP code includes these files from the filesystem.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
