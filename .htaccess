<IfModule mod_headers.c>
  # T-30: security headers for static files too (PHP responses get the same
  # set from config/security_headers.php).
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; media-src 'self'; worker-src 'self' blob:"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# T-55: production caching policy.
#   - HTML and PHP are always revalidated, so a deploy is visible immediately.
#   - CSS/JS are versioned with ?v= in the pages, so they can be cached hard.
#   - Images/fonts get a shorter cache because some are referenced without a
#     version string.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Compress text-based assets when the host has mod_deflate enabled.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# T-52: friendly 404 page. Adjust this path if the project is deployed at the
# domain root instead of /pdrsystem/.
ErrorDocument 404 /pdrsystem/customer/404.html

# Never serve database dumps, secrets, logs or editor/backup artifacts.
# A .sql dump contains customer PII and admin password hashes; a leaked
# .env contains live SMTP credentials.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(sql|sql\.gz|log|env|bak|old|orig|swp|swo|zip|tar|gz|ini|yml|yaml)$|(^|/)\.env$|~$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)\.(sql|sql\.gz|log|env|bak|old|orig|swp|swo|zip|tar|gz|ini|yml|yaml)$|(^|/)\.env$|~$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
