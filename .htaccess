<IfModule mod_headers.c>
  # Dev convenience: always revalidate site files so edits show up on a
  # normal refresh (no more stale CSS/JS after code changes).
  # If this project is ever deployed to a real host, replace with long
  # cache lifetimes for /assets and HTML files marked no-cache.
  <FilesMatch "\.(html|htm|css|js|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Never serve database dumps, secrets, logs or editor/backup artifacts.
# A .sql dump contains customer PII and admin password hashes; a leaked
# .env contains live SMTP credentials.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(sql|sql\.gz|log|env|bak|old|orig|swp|swo|zip|tar|gz|ini|yml|yaml)$|(^|/)\.env$|~$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)\.(sql|sql\.gz|log|env|bak|old|orig|swp|swo|zip|tar|gz|ini|yml|yaml)$|(^|/)\.env$|~$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
