# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# --- SMTP (leave the password blank to use outbox mode) -------------------
PDR_MAIL_ENABLED=true
PDR_MAIL_HOST=smtp.gmail.com
PDR_MAIL_PORT=587
PDR_MAIL_ENCRYPTION=tls
PDR_MAIL_USERNAME=
PDR_MAIL_PASSWORD=
PDR_MAIL_FROM_EMAIL=
PDR_MAIL_FROM_NAME="Pio De Roda Cafe & Restaurant"

# Fixed recipient for the CLI-only mail self-test (no arbitrary addresses).
PDR_MAIL_TEST_RECIPIENT=

# Secret used to hash client IPs in lookup_attempts (use a long random value).
PDR_LOOKUP_SECRET=
