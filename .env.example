# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# --- Database (T-31) ------------------------------------------------------
# Local XAMPP defaults are used when these are absent.
PDR_DB_HOST=localhost
PDR_DB_PORT=3306
PDR_DB_NAME=pdrsystem
PDR_DB_USER=root
PDR_DB_PASS=

# --- SMTP (leave the password blank to use outbox mode) -------------------
PDR_MAIL_ENABLED=true
PDR_MAIL_HOST=smtp.gmail.com
PDR_MAIL_PORT=587
PDR_MAIL_ENCRYPTION=tls
PDR_MAIL_USERNAME=
PDR_MAIL_PASSWORD=
PDR_MAIL_FROM_EMAIL=
PDR_MAIL_FROM_NAME="Pio De Roda Cafe & Restaurant"

# Fixed recipient for the CLI-only mail self-test (no arbitrary addresses).
PDR_MAIL_TEST_RECIPIENT=

# Where the public contact form delivers inquiries.
PDR_CONTACT_RECIPIENT=

# Secret used to hash client IPs in lookup_attempts (use a long random value).
PDR_LOOKUP_SECRET=

# --- Cloudflare Turnstile (T-32 / T-45) ----------------------------------
# Leave both blank to disable the challenge (bookings/contact still work).
# Site key is public; the secret must never be committed.
PDR_TURNSTILE_SITE_KEY=
PDR_TURNSTILE_SECRET=
